# The one thing AirLink needs: an LLM key. You can also paste it in Settings instead.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # or this, with the provider set to OpenAI in Settings; also enables agent voices
# ELEVENLABS_API_KEY=        # transcribes calls in every browser
# CARTESIA_API_KEY=          # or set it in Settings: agent voices in huddles
# DEEPGRAM_API_KEY=          # or set it in Settings: agent voices in huddles
# E2B_API_KEY=               # run shared desktops on E2B instead of the Docker one

# Passwords and tokens the app and its sidecars share; change them if a port ever leaves loopback.
# AIRLINK_NEKO_PASSWORD=airlink
# AIRLINK_NEKO_API_TOKEN=airlink-neko
# AIRLINK_DESKTOP_PASSWORD=airlink
# AIRLINK_DESKTOP_TOKEN=airlink-desktop
# AIRLINK_RUNNER_TOKEN=airlink-runner
