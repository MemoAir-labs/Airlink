# The one thing AirLink needs: an LLM key for Pi. You can also paste it in Settings instead.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # or this, with the provider set to OpenAI in Settings; also enables agent voices
# ELEVENLABS_API_KEY=        # or set it in Settings: transcribes calls in every browser (Brave and Firefox have no speech service)
# CARTESIA_API_KEY=          # or set it in Settings: agent voices in huddles
# DEEPGRAM_API_KEY=          # or set it in Settings: agent voices in huddles

# Everything below has a default that matches docker-compose.yml.
# AIRLINK_PORT=3030          # the app
# AIRLINK_LIVE_PORT=3031     # the live socket
# AIRLINK_HOST=127.0.0.1     # 0.0.0.0 to let others on your network join (anyone who reaches it can, under any name)
# AIRLINK_DATA_DIR=.airlink  # settings, agents, memory and the signing secret
# AIRLINK_DATABASE_URL=postgres://airlink:airlink@localhost:5434/airlink
# LIVEKIT_URL=ws://localhost:7880   # "off" to run without calls
# AIRLINK_BROWSERS=off       # to run without the shared browser
# AIRLINK_DESKTOP=off        # to run without the shared desktop (compose's "desktop" service)
# AIRLINK_DESKTOP_PASSWORD=airlink        # its viewer password; must match compose
# AIRLINK_DESKTOP_TOKEN=airlink-desktop   # its control token; must match compose. Change it if port 3035 is ever exposed beyond loopback
# AIRLINK_RUNNER=off         # to run without code runners (compose's "runner" service)
# AIRLINK_RUNNER_TOKEN=airlink-runner     # the code runner's control token; must match compose. Change it if port 3036 is ever exposed beyond loopback
# E2B_API_KEY=               # run shared desktops on E2B instead of the Docker one
